# sandbox (por defecto) muestra el aviso de datos no productivos en toda la aplicación.
# Declara production únicamente cuando la instancia sirva información operativa real.
NEXT_PUBLIC_APP_ENV=sandbox
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=obtener_con_npm_run_db_status
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_RASTER_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Evento que sirve esta instancia. Si se omiten, la aplicación usa el evento sintético
# de supabase/seed.sql, que es lo correcto en local. Un despliegue desde cero crea su
# propio evento con `npm run bootstrap:environment` y declara aquí lo que ese comando imprime.
# NEXT_PUBLIC_EVENT_ID=
# NEXT_PUBLIC_EVENT_SLUG=
