{
  "name": "ruta-solidaria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-local.ps1",
    "db:restore:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-local.ps1",
    "db:test": "supabase test db",
    "test:rls": "node --env-file=.env.local scripts/verify-rls.mjs",
    "test:concurrency": "node --env-file=.env.local scripts/verify-intake-concurrency.mjs",
    "db:status": "supabase status",
    "audit:a11y": "node scripts/accessibility-audit.mjs",
    "audit:visual": "node scripts/visual-metrics.mjs",
    "preflight:local": "node --env-file=.env.local scripts/preflight-local.mjs",
    "preflight:deploy": "node scripts/preflight-deployment.mjs",
    "env:suite": "supabase db reset",
    "env:entrega": "supabase db reset --no-seed",
    "bootstrap:environment": "node scripts/bootstrap-environment.mjs",
    "verify:environment-flow": "node scripts/verify-environment-flow.mjs",
    "simulate:sandbox": "node scripts/simulate-sandbox-flow.mjs",
    "verify": "npm run preflight:local && npm run lint && npm run typecheck && npm run test && npm run db:test && npm run test:rls && npm run test:concurrency && npm run build && npm run db:reset && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "maplibre-gl": "^6.3.0",
    "next": "16.3.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.1",
    "jsdom": "27.2.0",
    "supabase": "2.114.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
